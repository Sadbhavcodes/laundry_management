# Exact production origin, for example https://laundryhub.example.com
FRONTEND_PRODUCTION_ORIGIN=https://your-production-domain.example

# Vercel project slug. Preview deployment hostnames beginning with
# <slug>- and ending in .vercel.app are allowed by the Edge Function CORS helper.
VERCEL_PROJECT_SLUG=your-vercel-project-slug

# Optional comma-separated exact origins (include scheme and port if needed).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "failure" to exercise the mock provider failure path; otherwise mock success is used.
NOTIFICATION_MOCK_MODE=success
